<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_footer_kuady">
        <div class="row" style="font-family: 'AngsanaNew'; font-size: 22.5px; line-height: 0.9em;">
            <div class="col-12">
                <div class="row ">
                    <div class="col-12">
                        <table class="table-borderless" style="width: 100%; margin: 0; border-collapse: collapse; table-layout: fixed;">
                            <tr>
                                <td style="width: 85%; text-align: right; font-weight: bold; padding: 2px 4px; border: 1px solid #000;">
                                    <span>TOTAL PRICE BAHT EXCLUDE VAT 7%</span>
                                </td>
                                <td style="width: 15%; text-align: right; font-weight: bold; padding: 2px 4px; border-top: 1px solid #000; border-bottom: 1px solid #000; border-right: 1px solid #000;">
                                    <span class="o_report_last_page" style="display: none;" t-esc="'%.2f' % o.amount_untaxed"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="row o_report_first_page" style="display: none; margin: 0 !important; padding: 0 !important;">
                    <div class="col-12">
                        <span>Above price are Thai Baht Excluded Vat (7%) Cancellation fee 25% based on order value</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <t t-foreach="range(o.sudo()._get_kuady_total_page_count())" t-as="kuady_other_page_index">
                            <!-- line-height must sit on each <span>, not on this
                                 wrapping div: wkhtmltopdf does not apply a
                                 block-level line-height to line boxes formed
                                 by inline content + <br/> here - verified
                                 empirically, it has zero effect at this level. -->
                            <div class="o_report_page_item" t-att-data-report-page="kuady_other_page_index + 1" style="display: none; width: 100%; margin: 0 !important; padding: 0 !important;">
                                <t t-foreach="o.sudo()._get_kuady_other_page_lines(kuady_other_page_index)" t-as="line">
                                    <span t-esc="line" style="line-height: 0.9em;"/>
                                    <t t-if="not line_last">
                                        <br/>
                                    </t>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="o_report_last_page" style="display: none;">
                    <div class="row">
                        <div class="col-12">
                            <span style="line-height: 0.9em;">Yours Sincerely</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-5">
                            <span style="line-height: 0.9em;">Kaudy Incorporation (Asia) Co., Ltd.</span>
                        </div>
                        <div class="col-7">
                            <span style="line-height: 0.9em;">Offer Approver</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-5" style="text-align:center;">
                            <div style="width: 80%; margin: 0 auto 4px auto; min-height: 56.25px; vertical-align: middle; display: flex; justify-content: center; align-items: center;">
                                <img t-if="o.env.user.user_signature" t-att-src="image_data_uri(o.env.user.user_signature)" style="display: block; margin: 0 auto; max-width: 100%; max-height: 56.25px;"/>
                            </div>
                            <div style="line-height: 1; margin: 0;">(                                <span style="font-weight: bold;" t-field="o.env.user.name"></span>)
                            </div>
                            <t t-if="o.env.user.job_title">
                                <div style="line-height: 1; margin: -16px 0 0 0;">
                                    <span style="font-weight: bold;" t-field="o.env.user.job_title"></span>
                                </div>
                            </t>
                        </div>

                        <div class="col-3" style="text-align:center;">
                            <div style=" width: 80%; margin: 0 auto 4px 0; min-height: 56.25px; vertical-align: middle; display: flex; justify-content: center; align-items: center;">
                            </div>

                                (                            <span style="font-weight: bold;"></span>)
                            <span></span>
                        </div>
                        <div class="col-4" style="text-align:right;">
                            <div style="height: 56.25px;"></div>
                            <span>F-MK-01</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <t t-call="bs_report_pagination_helper.page_visibility_script"/>
    </template>
</odoo>
