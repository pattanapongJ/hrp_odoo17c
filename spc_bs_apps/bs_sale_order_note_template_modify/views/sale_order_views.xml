<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_modify" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.modify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='terms_template_ids']" position="before">
                <span colspan="2"><strong>Subject Template:</strong></span>
                <field
                    name="subject_template_id"
                    placeholder="Subject Template"
                    nolabel="1"
                    colspan="2"
                    readonly="state != 'draft'"
                />
                <field
                    name="subject_template_text"
                    colspan="2"
                    invisible="not subject_template_id"
                />
                <span colspan="2"><strong>Other Template:</strong></span>
                <field
                    name="other_template_id"
                    placeholder="Other Template"
                    nolabel="1"
                    colspan="2"
                    readonly="state != 'draft'"
                />
                <field
                    name="other_template_text"
                    colspan="2"
                    invisible="not other_template_id"
                />
            </xpath>
            <xpath expr="//field[@name='terms_template_ids']" position="replace">
            </xpath>
            <xpath expr="//field[@name='note']" position="replace">    
            </xpath>
        </field>
    </record>

</odoo>
