<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_header_info_g_plus">
        <div class="row">
            <div class="col-12" style="font-family: 'AngsanaUPC'; ">
                <div style="display: table; width: 100%; border-bottom: 1px solid #000; background-color: #CBE6FA;">
                    <div style="display: table-cell; vertical-align: middle; text-align: center; width: 16.6667%;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="
                            max-width: 100%;
                            max-height: 131.25px;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            display: inline-block;
                        " alt="Logo"/>
                    </div>
                    <div style="display: table-cell; vertical-align: middle; text-align: left; width: 83.3333%; font-weight: bold; font-size: 13.2px;">
                        <div class="row">
                            <div class = "col-12" style="white-space: nowrap; overflow: hidden;">
                                <span style="font-size: 16.5px; font-weight: bold;" t-field="o.company_id.name_en"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2">
                                <span>Address : </span>
                            </div>
                            <div class="col-10" style="margin-left:-49.69px;">
                                <span t-field="o.company_id.street_en"/>
                                <span t-field="o.company_id.street2_en"/>
                                <br/>
                                <span t-field="o.company_id.city_en"/>
                                <span t-field="o.company_id.state_id_en"/>
                                <span t-field="o.company_id.zip_en"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3">
                                <span>Tel : </span>
                                <t t-if="o.company_id.phone">
                                    <span t-esc="o.company_id.phone"/>
                                </t>
                                <t t-if="not o.company_id.phone">
                                    <span> - </span>
                                </t>
                            </div>
                            <div class="col-3">
                                <span>Fax : </span>
                                <t t-if="o.company_id.fax">
                                    <span t-esc="o.company_id.fax"/>
                                </t>
                                <t t-if="not o.company_id.fax">
                                    <span> - </span>
                                </t>
                            </div>
                            <div class="col-6"></div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <span>E-Mail :   </span>
                                <t t-if="o.env.user.employee_id.work_email">
                                    <span t-esc="o.env.user.employee_id.work_email"/>
                                </t>
                                <t t-if="not o.env.user.employee_id.work_email">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <span>Website : </span>
                                <t t-if="o.company_id.website">
                                    <span t-esc="o.company_id.website"/>
                                </t>
                                <t t-if="not o.company_id.website">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row pt-2" style="font-weight: Regular; font-size: 12.09px;">
                    <div class="col-11"/>
                    <div class="col-1 text-center">
                        <span>Page</span>
                        <span class="page"/>
                        <span>/</span>
                        <span class="topage"/>
                    </div>
                </div>
                <div class="row pb-2 pt-3" style="font-weight: bold; font-size: 16.5px;">
                    <div class="col-4"/>
                    <div class="col-4 text-center">
                        <span>Quotation</span>
                    </div>
                    <div class="col-4 "/>
                </div>
                <div class="row py-1" style="font-size: 12.09px; padding-left:2.81px;">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Attention</span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.partner_id.contact_person">
                                    <span t-field="o.partner_id.contact_person"/>
                                </t>
                                <t t-if="not o.partner_id.contact_person">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 ">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Quotation No</span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.name">
                                    <span t-field="o.name"/>
                                </t>
                                <t t-if="not o.name">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row py-1" style="font-size: 12.09px; padding-left:2.81px;">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Company  </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.partner_id.name_company">
                                    <span t-field="o.partner_id.name_company"/>
                                </t>
                                <t t-if="not o.partner_id.name_company">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Date </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.date_order">
                                    <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                </t>
                                <t t-if="not o.date_order">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row py-1" style="font-size: 12.09px; padding-left:2.81px;">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Tel </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.partner_id.phone">
                                    <span t-esc="o.partner_id.phone"/>
                                </t>
                                <t t-if="not o.partner_id.phone">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Delivery Time </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.delivery_time">
                                    <span t-esc="o.delivery_time"/>
                                </t>
                                <t t-if="not o.delivery_time">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row py-1" style="font-size: 12.09px; padding-left:2.81px;">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Mail </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8  text-left">
                                <t t-if="o.partner_id.email">
                                    <span t-esc="o.partner_id.email"/>
                                </t>
                                <t t-if="not o.partner_id.email">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Term of Payment </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.payment_term_id">
                                    <span t-field="o.payment_term_id"/>
                                </t>
                                <t t-if="not o.payment_term_id">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row py-1" style="font-size: 12.09px; padding-left:2.81px;">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>From </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.user_id">
                                    <span t-esc="o.user_id.name"/>
                                    <span> ( </span>
                                    <span t-esc="o.user_id.phone or '-'"/>
                                    <span> )</span>
                                </t>
                                <t t-if="not o.user_id">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3 text-left" style="font-weight: bold;">
                                <span>Validity : </span>
                            </div>
                            <div class = "col-1 text-center">
                                <spam>:</spam>
                            </div>
                            <div class="col-8 text-left">
                                <t t-if="o.validity_date">
                                    <span t-field="o.validity_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                </t>
                                <t t-if="not o.validity_date">
                                    <span> - </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
