<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_footer_ramer">
        <div class="row" style="font-family: 'Times New Roman'; font-size: 14px;">
            <div class="col-12">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <table class="table-borderless" style="width: 100%; margin: 0; border-collapse: collapse; table-layout: fixed;">
                                <tr>
                                    <td style="width: 80%; text-align: right; padding: 2px 4px; border: 1px solid #000; font-weight: bold;">
                                        <span>TOTAL PRICE BAHT EXCLUDE VAT</span>
                                    </td>
                                    <td style="width: 20%; text-align: right; padding: 2px 4px; border-top: 1px solid #000; border-bottom: 1px solid #000; border-right: 1px solid #000;">
                                        <span class="o_report_last_page" style="display: none;" t-esc="'%.2f' % o.amount_untaxed"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 80%; text-align: right; padding: 2px 4px; border: 1px solid #000; font-weight: bold;">
                                        <span>VAT 7%</span>
                                    </td>
                                    <td style="width: 20%; text-align: right; padding: 2px 4px; border-top: 1px solid #000; border-bottom: 1px solid #000; border-right: 1px solid #000;">
                                        <span class="o_report_last_page" style="display: none;" t-esc="'%.2f' % o.amount_tax"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 80%; text-align: right; padding: 2px 4px; border: 1px solid #000; font-weight: bold;">
                                        <span>TOTAL PRICE BAHT INCLUDE VAT</span>
                                    </td>
                                    <td style="width: 20%; text-align: right; padding: 2px 4px; border-top: 1px solid #000; border-bottom: 1px solid #000; border-right: 1px solid #000;">
                                        <span class="o_report_last_page" style="display: none;" t-esc="'%.2f' % o.amount_total"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </div>
                <div class="row o_report_first_page" style="display: none; margin: 0 !important; padding: 0 !important;">
                    <div class="col-12">
                        <span>Cancellation of order is subject to charge 25% based on order value</span>
                        <br/>
                        <span>According to general conditions ORGALIME S2012</span>
                    </div>
                </div>
                <div class="row" style="margin: 0 !important; padding: 0 !important;">
                    <div class="col-12">
                        <t t-foreach="range(o.sudo()._get_ramer_total_page_count())" t-as="ramer_other_page_index">
                            <div class="o_report_page_item" t-att-data-report-page="ramer_other_page_index + 1" style="display: none; width: 100%; margin: 0 !important; padding: 0 !important;">
                                <t t-foreach="o.sudo()._get_ramer_other_page_lines(ramer_other_page_index)" t-as="line">
                                    <span t-esc="line"/><t t-if="not line_last"><br/></t>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
        <t t-call="bs_report_pagination_helper.page_visibility_script"/>
    </template>
</odoo>
