<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_header_info_ramer">
        <div class="row" style="font-family: 'Times New Roman'; font-size: 14px;">
            <div class="col-12">
                <div class="row" style="font-weight: bold; display: table; width: 100%;">
                    <div class="col-3" style="display: table-cell; vertical-align: middle;">
                        <div style="text-align: center; width: 90%;">
                            <img t-if="o.brand_logo_id.logo" t-att-src="image_data_uri(o.brand_logo_id.logo)" style="
                            max-width: 100%;
                            max-height: 93px;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            display: inline-block;
                        " alt="Logo"/>
                            <img t-elif="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="
                            max-width: 100%;
                            max-height: 93px;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            display: inline-block;
                        " alt="Logo"/>
                        </div>
                    </div>
                    <div class="col-5" style="display: table-cell; vertical-align: top;">
                        <span t-field="o.company_id.name_en"/>
                        <br/>
                        <span t-field="o.company_id.street_en"/>
                        <br/>
                        <span t-field="o.company_id.street2_en"/>
                        <span t-field="o.company_id.city_en"/>
                        <span t-field="o.company_id.state_id_en"/>
                        <span t-field="o.company_id.zip_en"/>
                    </div>
                    <div class="col-4 text-left" style="display: table-cell; vertical-align: middle;">
                        <span>Tel:</span>
                        <span t-field="o.company_id.phone"/>
                        <br/>
                        <span>Hotline Service :</span>
                        <span t-field="o.company_id.mobile"/>
                        <br/>
                        <span>E-mail:</span>
                        <span t-field="o.company_id.email"/>
                        <br/>
                        <br/>
                        <div style="text-align: right; font-weight: regular;">
                            <span>Page</span>
                            <span class="page"/>
                            <span>/</span>
                            <span class="topage"/>
                        </div>

                    </div>
                </div>
                <div class="row" style="font-weight: bold; border: 1px solid black;">
                    <div class="col-12 text-center">
                        <span style="font-size: 23px;">QUOTATION</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-7" style="border-right: 1px solid black;">
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Quotation Date </span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Company</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.partner_id.name_company"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>ATTN</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.partner_id.contact_person"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Tel</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.partner_id.phone"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>E-mail</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.partner_id.email"/>
                            </div>
                        </div>
                        <div class="row" style="font-weight: bold; border-top: 1px solid black;">
                            <span>Sales Conditions</span>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Validate</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.validity_date"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Delivery time</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.delivery_time"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Payment</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.payment_term_id"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="row">
                            <div class="col-7 text-center" style="font-weight: bold;">
                                Quotation No.
                            </div>
                            <div class="col-5 text-center" style="font-weight: bold;">
                                <span t-field="o.name"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="padding-left: 5px;font-weight: bold;">
                                <span>Sales</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.env.user.name"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="padding-left: 5px; font-weight: bold;">
                                <span>Mobile</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.env.user.mobile"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="padding-left: 5px; font-weight: bold;">
                                <span>E-mail</span>
                            </div>
                            <div class="col-1 text-center">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.env.user.email"/>
                            </div>
                        </div>
                        <div class="row" style="border-top: 1px solid black;">
                            <div class="col-12 text-center" style="font-weight: bold;">
                                <div style="vertical-align: middle; text-align: center; width: 90   %;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="
                            max-width: 100%;
                            max-height: 67px;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            display: inline-block;  
                            opacity: 0;
                        " alt="Logo"/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-center" style="font-weight: bold;">
                                <!-- <span t-field="o.env.user.email"/> -->
                                <span style="color: transparent; opacity: 0; user-select: none;" >Authorized  Signature  / Date  Authorized</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-center" style="font-weight: bold;">
                                <span>Authorized  Signature  / Date  Authorized</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="border-top: 1px solid black; padding-top: 5px; padding-bottom: 5px;">
                    <div class="col-12" style="font-weight: Regular; overflow: hidden; height: 3.0em; line-height: 0.9em;">
                        <span t-field="o.subject_template_text"/>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
