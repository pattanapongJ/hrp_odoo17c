<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_main_content_ramer_table_head">
        <thead >
            <tr>
                <th style="width: 5%; text-align: center; vertical-align: middle; border: 1px solid #000;">
                    <span>Item</span>
                </th>
                <th style="width: 35%; text-align: center; vertical-align: middle; border: 1px solid #000;">
                    <span>Description</span>
                </th>
                <th style="width: 10%; text-align: center; vertical-align: middle; border: 1px solid #000;">
                    <span>Qty</span>
                </th>
                <th style="width: 10%; text-align: center; vertical-align: middle; border: 1px solid #000;">
                    <span>Unit</span>
                </th>
                <th style="width: 20%; text-align: center; vertical-align: middle; border: 1px solid #000;">
                    <span>Price/EA (Baht)</span>
                </th>
                <th style="width: 20%; text-align: center; vertical-align: middle; border: 1px solid #000;">
                    <span>Total price</span>
                </th>
            </tr>
        </thead>
    </template>

    <template id="report_main_content_ramer">
        <div style="font-family: 'Times New Roman'; font-size: 21px;" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <table class="table-borderless" style="width: 100%; margin: 0; border-collapse: collapse; table-layout: fixed;">
                <t t-call="bs_create_form_quotation_ramer.report_main_content_ramer_table_head"/>
                <tbody>
                    <tr t-foreach="o.sudo().order_line.filtered(lambda l: not l.display_type)" t-as="line">
                        <td style="text-align: center;  ">
                            <span t-esc="line_index + 1"/>
                        </td>
                        <td style="text-align: left;  ">
                            <span t-field="line.name"/>
                        </td>
                        <td style="text-align: center; ">
                            <span t-field="line.product_uom_qty"/>
                        </td>
                        <td style="text-align: center; ">
                            <span t-field="line.product_uom"/>
                        </td>
                        <td style="text-align: right; ">
                            <span t-esc="'%.2f' % line.price_unit"/>
                        </td>
                        <td style="text-align: right; ">
                            <span t-esc="'%.2f' % line.price_before_tax"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <t t-foreach="range(1, o.sudo()._get_ramer_total_page_count())" t-as="ramer_extra_page_index">
            <div style="box-sizing: border-box; page-break-before: always; font-family: 'Times New Roman'; font-size: 21px;">
                <table class="table-borderless" style="width: 100%; margin: 0; border-collapse: collapse; table-layout: fixed;">
                    <t t-call="bs_create_form_quotation_ramer.report_main_content_ramer_table_head"/>
                </table>
            </div>
        </t>
    </template>
</odoo>
