<odoo>
    <!-- fsm.person.team_id (base fieldservice) only ever lets a worker
         belong to ONE team. Team membership is now owned by the Team
         itself (bs.fsm.team.member.line, see the Members tab on the Team
         form), letting the same worker belong to several teams - so this
         single-team field is hidden here rather than used/edited, without
         touching the base module's column. -->
    <record id="fsm_person_tree_bs_fieldservice" model="ir.ui.view">
        <field name="name">fsm.person.tree.bs.fieldservice</field>
        <field name="model">fsm.person</field>
        <field name="inherit_id" ref="fieldservice.fsm_person_tree" />
        <field name="arch" type="xml">
            <field name="team_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="fsm_person_form_bs_fieldservice" model="ir.ui.view">
        <field name="name">fsm.person.form.bs.fieldservice</field>
        <field name="model">fsm.person</field>
        <field name="inherit_id" ref="fieldservice.fsm_person_form" />
        <field name="arch" type="xml">
            <field name="team_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
