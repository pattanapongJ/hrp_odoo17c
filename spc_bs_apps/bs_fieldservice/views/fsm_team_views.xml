<odoo>
    <record id="view_team_form_bs_fieldservice" model="ir.ui.view">
        <field name="name">fsm.team.form.bs.fieldservice</field>
        <field name="model">fsm.team</field>
        <field name="inherit_id" ref="fieldservice.view_team_form" />
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="team_side" />
            </field>
            <field name="calendar_user_id" position="after">
                <field name="team_manager_id" />
            </field>
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page string="Members" name="members">
                        <field name="member_ids">
                            <tree editable="bottom">
                                <field name="person_id" options="{'no_create': True}" />
                                <field
                                    name="category_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                                    groups="fieldservice.group_fsm_category"
                                />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
