<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_header_info">
        <div style="font-family: 'THSarabunNew'; font-size: 18px;">
            <div class="row">
                <div class="col-7">
                    <div class="row">
                        <div class="col-2">
                            <span style="text-align: left;">
                                ชื่อผู้ขาย :
                            </span>
                        </div>
                        <div class="col-10" style="margin-left: -20px;">
                            <span style="text-align: left;" t-field="o.company_id.name"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <span style="text-align: left;">
                                ที่อยู่ :
                            </span>
                        </div>
                        <div class="col-10" style="margin-left: -20px;">
                            <span t-field="o.company_id.street"/>
                            <span t-field="o.company_id.street2"/>
                            <span t-field="o.company_id.city"/>
                            <br/>
                            <span t-field="o.company_id.state_id"/>
                            <span t-field="o.company_id.zip"/>
                            <span t-field="o.company_id.country_id"/>
                        </div>
                    </div>
                    <div class="row" style="text-align: left;">
                        <div class="col-2">
                            <span>
                                สาขา :
                            </span>
                        </div>
                        <div class="col-3" style="margin-left: -20px;">
                            <span t-field="o.company_id.branch"/>
                        </div>
                        <div class="col-2" style="margin-left: -25px;">
                            <span>
                            เลขที่ผู้เสียภาษี
                            </span>
                        </div>
                        <div class="col-3">
                            <span t-field="o.company_id.vat"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <span style="text-align: left;">
                                รหัสลูกค้า :
                            </span>
                        </div>
                        <div class="col-10" style="margin-left: -20px;">
                            <span t-field="o.partner_id.partner_code"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <span style="text-align: left;">
                               นามผู้ซื้อ :
                            </span>
                        </div>
                        <div class="col-10" style="margin-left: -20px;">
                            <span t-field="o.partner_id.name"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <span style="text-align: left;">
                                ที่อยู่ :
                            </span>
                        </div>
                        <div class="col-10" style="margin-left: -20px;">
                            <span t-field="o.partner_id.street"/>
                            <span t-field="o.partner_id.street2"/>
                            <span t-field="o.partner_id.city"/>
                            <br/>
                            <span t-field="o.partner_id.state_id"/>
                            <span t-field="o.partner_id.zip"/>
                            <span t-field="o.partner_id.country_id"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <span>
                                สาขา : 
                            </span>
                        </div>
                        <div class="col-3" style="margin-left: -20px;">
                            <span t-field="o.partner_id.branch"/>
                        </div>
                        <div class="col-2" style="margin-left: -25px;">
                            <span>
                            เลขที่ผู้เสียภาษี
                            </span>
                        </div>
                        <div class="col-3">
                            <span t-field="o.partner_id.vat"/>
                        </div>
                    </div>
                </div>
                <div class="col-5" style="margin-left: 20px; margin-top: 115px;">
                    <div class="row">
                        <div style="padding-left: 60px;">
                            <span style="text-align: left;" t-field="o.name"/>
                        </div>
                    </div>
                    <div class="row" style="margin-right: 50px; margin-top: 40px;">
                        <span style="text-align: left;" t-field="o.invoice_date" t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                    </div>
                    <div class="row" style="margin-top: 40px; padding-right:30px;">
                        <div class="col-2" style="white-space: nowrap; padding-left:5px;">
                            <span t-field="o.invoice_payment_term_id.name"/>
                        </div>
                        <div class="col-7">
                        </div>
                        <div class="col-3" style="padding-left:7.5px;">
                            <span t-field="o.invoice_date_due"/>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin-top: 40px; padding-left: 30px;">
                <div class="col-1"/>
                <div class="col-4" style="margin-left: 15px; padding-top: 10px;">
                    <span style="text-align: left;" t-field="o.payment_reference"/>
                </div>
                <div class="col-3"/>
                <div class="col-4" style="margin-left: 5px; padding-top: 10px;">
                    <span t-field="o.invoice_user_id"/>
                </div>
            </div>
        </div>
    </template>
</odoo>