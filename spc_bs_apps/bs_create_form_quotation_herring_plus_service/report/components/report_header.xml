<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_header_info_herring_plus_service">
        <div class="row">
            <div class="col-12" style="font-family: 'AngsanaUPC'; font-size: 13.33px;">
                <div class="row">
                    <div class="col-3 text-center">
                        <div style="vertical-align: middle; text-align: center; width: 90%;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="
                            max-width: 100%;
                            max-height: 100px;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            display: inline-block;
                        " alt="Logo"/>
                        </div>
                    </div>
                    <div class="col-6 text-center" style="font-weight: bold;">
                        <span style="font-size: 21.33px;" t-field="o.company_id.name_en"/>
                        <br/>
                        <span t-field="o.company_id.street_en"/>
                        <br/>
                        <span t-field="o.company_id.street2_en"/>
                        <span t-field="o.company_id.city_en"/>
                        <span t-field="o.company_id.state_id_en"/>
                        <span t-field="o.company_id.country_id_en"/>
                        <br/>
                        <span>Hot Line : </span>
                        <span t-field="o.company_id.mobile"/>
                        <span>Tel : </span>
                        <span t-field="o.company_id.phone"/>
                        <span>Fax : </span>
                        <span t-field="o.company_id.fax"/>
                        <br/>
                        <span>E-Mail : </span>
                        <span t-field="o.company_id.email"/>
                    </div>
                    <div class="col-3 text-center">
                        <div style="vertical-align: middle; text-align: center; width: 90%;">
                            <div style="text-align: center; width: 90%;">
                                <img t-if="o.brand_logo_id.logo" t-att-src="image_data_uri(o.brand_logo_id.logo)" style="
                            max-width: 100%;
                            max-height: 100px;
                            width: auto;
                            height: auto;
                            object-fit: contain;
                            display: inline-block;
                        " alt="Logo"/>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="border-top: 1px solid black;">
                    <div class="col-12 text-end" style="text-align: right; font-weight: regular;">
                        <span>Page</span>
                        <span class="page"/>
                        <span>/</span>
                        <span class="topage"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-center" style="text-align: right; font-weight: bold; font-size: 21.33px;">
                        <span>Quotation</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-2" style="font-weight: bold;">
                                <span>To</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-9">
                                <span t-field="o.partner_id"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2" style="font-weight: bold;">
                                <span>Attention</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-9">
                                <span t-field="o.partner_id.contact_person"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2" style="font-weight: bold;">
                                <span>Tel</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-9">
                                <span t-field="o.partner_id.phone"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2" style="font-weight: bold;">
                                <span>E-mail</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-9">
                                <span t-field="o.partner_id.email"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2" style="font-weight: bold;">
                                <span>From</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-9">
                                <span t-field="o.user_id"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Quotation No.</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.name"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Date</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-9">
                                <span t-field="o.date_order" t-options="{'format': 'MM/dd/yyyy'}"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Delivery Date</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.delivery_time"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Validity</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.validity_date"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3" style="font-weight: bold;">
                                <span>Payment Term</span>
                            </div>
                            <div class="col-1" style="font-weight: bold;">
                                <span>:</span>
                            </div>
                            <div class="col-8">
                                <span t-field="o.payment_term_id"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-2" style="border-top: 1px solid black;">
                    <div class="col-12 mt-1">
                        <div style="overflow: hidden; height: 3.0em; line-height: 1.0em; font-size: 13.33px;">
                            <span t-field="o.subject_template_text"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
